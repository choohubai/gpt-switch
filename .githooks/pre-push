#!/bin/sh
# Build and upload the macOS installer for a version tag before it reaches GitHub.
#
# A tag-only push cannot be hooked cleanly: git advertises the remote refs before
# pre-push runs, so a tag pushed from inside the hook races the outer push. This
# hook therefore runs when `main` is pushed, which is the step right after tagging:
#
#   git tag -a v0.1.26 -m "Release v0.1.26"
#   git push origin main
#
# Any version tag pointing at the pushed commit that has no GitHub Release yet is
# packaged locally and uploaded. Enable per clone with:
#
#   git config core.hooksPath .githooks
#
# Bypass with `git push --no-verify`.
set -u

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" 2>/dev/null || exit 0
release="$root/local-release.sh"
[ -x "$release" ] || exit 0

pushing_main=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;;
    *) pushing_main=1 ;;
  esac
done
[ "$pushing_main" = 1 ] || exit 0

[ "$(git -C "$root" branch --show-current 2>/dev/null)" = main ] || exit 0

if [ -n "$(git -C "$root" status --porcelain)" ]; then
  printf '跳过本地打包：工作树不干净，请提交后再推送 main。\n' >&2
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  printf '提示：未找到 gh，无法自动上传安装包。安装后运行 ./local-release.sh prepare <版本> && ./local-release.sh publish <版本>。\n' >&2
  exit 0
fi

status=0
for tag in $(git -C "$root" tag --points-at HEAD); do
  case "$tag" in
    v[0-9]*.[0-9]*.[0-9]*) ;;
    *) continue ;;
  esac
  if gh release view "$tag" >/dev/null 2>&1; then
    continue
  fi
  version="${tag#v}"
  printf '检测到未发布的 %s，正在本地打包并上传安装包...\n' "$tag" >&2
  if ! GPT_SWITCH_RELEASE_SKIP_SYNC=1 "$release" prepare "$version" >&2; then
    printf '错误：%s 打包失败，已取消推送。\n' "$tag" >&2
    status=1
    continue
  fi
  if ! GPT_SWITCH_RELEASE_SKIP_SYNC=1 "$release" publish "$version" >&2; then
    printf '错误：%s 上传失败，已取消推送；修复后重新 git push origin main。\n' "$tag" >&2
    status=1
  fi
done
exit "$status"
